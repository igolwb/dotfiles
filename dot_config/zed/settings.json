// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

{
  "soft_wrap": "editor_width",
  "horizontal_scroll_margin": 5.0,
  "global_lsp_settings": {
    "button": false,
  },
  "disable_ai": false,
  "vertical_scroll_margin": 18.0,
  "scroll_beyond_last_line": "one_page",
  "format_on_save": "off",
  "preferred_line_length": 120,
  "collaboration_panel": {
    "button": false,
  },
  "toolbar": {
    "code_actions": false,
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
  },
  "zoomed_padding": true,
  "minimap": {
    "thumb": "always",
    "show": "never",
  },
  "gutter": {
    "git_gutter_width": "default",
    "min_line_number_digits": 0,
    "runnables": false,
    "bookmarks": false,
    "folds": false,
    "breakpoints": false,
    "line_numbers": true,
  },
  "hover_popover_sticky": true,
  "hover_popover_enabled": true,
  "accessible_mode": false,
  "which_key": {
    "enabled": true,
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "show_value_hints": true,
  },
  "inline_code_actions": true,
  "centered_layout": {
    "left_padding": 0.2,
  },
  "preview_tabs": {
    "enabled": true,
  },
  "use_system_window_tabs": false,
  "scrollbar": {
    "show": "auto",
    "axes": {
      "vertical": true,
      "horizontal": false,
    },
    "search_results": true,
  },
  "outline_panel": {
    "button": false,
  },
  "unnecessary_code_fade": 0.3,
  "edit_predictions": {
    "mode": "subtle",
  },
  "show_edit_predictions": false,
  "search": {
    "button": true,
  },
  "show_wrap_guides": true,
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 1.0,
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_worktree_name": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_sign_in": true,
    "show_user_menu": true,
    "show_user_picture": false,
    "show_menus": false,
    "show_branch_status_icon": true,
  },
  "vim_mode": false,
  "proxy": "",
  "bottom_dock_layout": "full",
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "file_icons": false,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
    "show": true,
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": true,
  },
  "terminal": {
    "dock": "bottom",
    "show_count_badge": false,
    "starts_open": false,
    "toolbar": {
      "breadcrumbs": false,
    },
    "default_height": 260.0,
    "flexible": false,
    "button": true,
  },
  "status_bar": {
    "show_active_file": false,
    "cursor_position_button": false,
    "active_language_button": false,
  },
  "autosave": "off",
  "agent_ui_font_size": 11.0,
  "agent_buffer_font_size": 10.0,
  "agent": {
    "flexible": false,
    "limit_content_width": false,
    "sidebar_side": "right",
    "default_height": 260.0,
    "sandbox_permissions": {
      "allow_all_hosts": true,
    },
    "default_model": {
      "provider": "ollama",
      "model": "ornith-coder:latest",
      "enable_thinking": true,
    },
    "dock": "bottom",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "text_rendering_mode": "platform_default",
  "ui_font_weight": 600.0,
  "ui_font_family": "Maple Mono NF",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 500.0,
  "buffer_font_family": "Maple Mono NF",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "starts_open": true,
    "scrollbar": {
      "horizontal_scroll": false,
    },
    "default_width": 140.0,
    "button": true,
    "hide_root": true,
    "indent_size": 10.0,
    "folder_icons": false,
    "file_icons": true,
    "entry_spacing": "standard",
    "dock": "left",
  },
  "icon_theme": "Zed (Default)",
  "agent_servers": {
    "cursor": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "ui_font_size": 11.0,
  "buffer_font_size": 11.5,
  "theme": {
    "mode": "dark",
    "light": "Old Book",
    "dark": "Noctalia Dark",
  },
}
