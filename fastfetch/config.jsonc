{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/cat.txt",

    "padding": {
      "left": 2,
      "right": 4,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    "break",
   	{
               "type": "title",
               "keyWidth": 10
           },
           "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "32", // = color1
    },
    {
        "type": "kernel",
        "key": " ",
        "keyColor": "32",
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "32",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "32",
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "32",
      "format": "{pretty-name}"
    },
    {
      "type": "terminalfont",
      "key": " ",
      "keyColor": "32",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7} GHz",
      "key": " ",
      "keyColor": "32",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "format": "{1} {2} @ {12} GHz",
      "key": "󰢮 ",
      "keyColor": "32",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "32",
      "format": "{used} / {total}"
    },
  ],
}
